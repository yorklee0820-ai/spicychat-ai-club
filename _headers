/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-jHYU66zQjYe70CvjKP/AXK1YotN/Knhvn30MkRxxzXk='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/assets/img/*
  Cache-Control: public, max-age=604800

/style.css
  Cache-Control: public, max-age=3600, must-revalidate
