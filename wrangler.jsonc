{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spicychat-ai-club",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "spicychat-ai.club", "custom_domain": true },
    { "pattern": "www.spicychat-ai.club", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist"
  }
}
